# ============================================================
# VARIÁVEIS DE AMBIENTE DO PROJETO - ALURA ALBUM TECH
# Copie este arquivo para .env e preencha os valores:
#   copy .env.example .env
# ============================================================

# [OBRIGATÓRIA] Chave secreta usada para assinar os tokens JWT.
# O servidor NÃO inicia sem ela. Gere uma chave segura com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# [OPCIONAL] URL do banco de dados.
# Se vazio, usa o SQLite local (backend/album.db) - ideal para desenvolvimento.
# Para PostgreSQL em produção (Neon, Supabase ou Render Postgres):
#   postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# [OPCIONAL] Origens permitidas no CORS (separadas por vírgula).
# Padrão: origens locais de desenvolvimento.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# [OPCIONAL] Limite de tentativas de login/registro por IP.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
